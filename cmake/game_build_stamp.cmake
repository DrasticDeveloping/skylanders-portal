# cmake -DGIT=<git> -DREPO=<game checkout> -DVERSION=<release version> -DOUT=<file> -P game_build_stamp.cmake
#
# Writes the build's version source (GameVersion, GameCommit; src/xex/xex_verify.h) for the log's
# first line. Run at every build by skylanders_game_xex, so the commit is the checkout's HEAD when
# the build ran, not when CMake last configured (a build made after new commits named the older
# one). OUT changes only when its text does, so an unchanged commit compiles nothing.
#
# A checkout with uncommitted changes is stamped `<commit>-dirty-<hash>`: <hash> is the first seven
# hex digits of the SHA-1 of `git diff HEAD --binary --submodule=diff` (tracked changes, the
# submodules' own tracked changes included) followed by each untracked, not ignored file's path and
# SHA-1. The same commit with the same changes gives the same stamp; a change anywhere in that set
# gives another one. Not covered: untracked files inside a submodule. Nothing is written to the
# repository (no index, no objects). A clean checkout keeps the plain `<commit>`.
set(commit "unknown")
if(GIT)
    execute_process(COMMAND "${GIT}" -C "${REPO}" rev-parse --short HEAD
                    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE failed)
    if(NOT failed AND head)
        set(commit "${head}")
        # Dirty means a content difference: `git diff HEAD` (line endings normalized the way git
        # stores the file) or an untracked file. Not `git status`: the codegen step rewrites
        # generated/rexglue.cmake and swapforcerecomp_manifest.toml with other line endings at
        # every build, which status lists as modified although their content equals HEAD, so every
        # build of a clean commit would have read dirty.
        execute_process(COMMAND "${GIT}" -C "${REPO}" diff HEAD --binary --submodule=diff
                        OUTPUT_VARIABLE changes ERROR_QUIET RESULT_VARIABLE status_failed)
        execute_process(COMMAND "${GIT}" -C "${REPO}" ls-files --others --exclude-standard
                        OUTPUT_VARIABLE untracked OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(status_failed)
            set(commit "${head}-dirty-unknown")
        elseif(changes OR untracked)
            if(untracked)
                string(REPLACE "\n" ";" untracked "${untracked}")
                foreach(path IN LISTS untracked)
                    if(EXISTS "${REPO}/${path}" AND NOT IS_DIRECTORY "${REPO}/${path}")
                        file(SHA1 "${REPO}/${path}" sum)
                        string(APPEND changes "\nuntracked ${path} ${sum}")
                    endif()
                endforeach()
            endif()
            string(SHA1 sum "${changes}")
            string(SUBSTRING "${sum}" 0 7 sum)
            set(commit "${head}-dirty-${sum}")
        endif()
    endif()
endif()
set(text "// Generated by skylanders_game_xex (cmake/game_build_stamp.cmake).\nnamespace skylanders::xex {\nconst char* GameVersion() { return \"${VERSION}\"; }\nconst char* GameCommit() { return \"${commit}\"; }\n}  // namespace skylanders::xex\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
